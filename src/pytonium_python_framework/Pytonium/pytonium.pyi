from typing import Any, Callable, Optional, Sequence

class Pytonium:
    def __init__(self) -> None: ...

    @classmethod
    def pytonium_subprocess_path(cls) -> str: ...

    @classmethod
    def set_subprocess_path(cls, value: str) -> None: ...

    def initialize(self, start_url: str, init_width: int, init_height: int) -> None: ...
    def return_value_to_javascript(self, message_id: int, value: Any) -> None: ...
    def execute_javascript(self, code: str) -> None: ...

    def bind_function_to_javascript(
        self,
        function_to_bind: Callable[..., Any],
        name: str = "",
        javascript_object: str = "",
    ) -> None: ...

    def bind_functions_to_javascript(
        self,
        functions_to_bind: list[Callable[..., Any]],
        names: Optional[list[str]] = None,
        javascript_object: str = "",
    ) -> None: ...

    def bind_object_methods_to_javascript(
        self,
        obj: object,
        names: Optional[list[str]] = None,
        javascript_object: str = "",
    ) -> None: ...

    def add_context_menu_entry(
        self,
        context_menu_entry_function: Callable[..., Any],
        display_name: str = "",
        context_menu_namespace: str = "",
    ) -> None: ...

    def add_context_menu_entries(
        self,
        context_menu_entry_functions: list[Callable[..., Any]],
        display_names: Optional[list[str]] = None,
        context_menu_namespace: str = "",
    ) -> None: ...

    def add_context_menu_entries_from_object(
        self,
        context_menu_entries_object: object,
        display_names: Optional[list[str]] = None,
        context_menu_namespace: str = "",
    ) -> None: ...

    def add_state_handler(self, state_handler: object, namespaces: list[str]) -> None: ...
    def set_context_menu_namespace(self, context_menu_namespace: str) -> None: ...
    def set_show_debug_context_menu(self, show: bool) -> None: ...

    def add_context_menu_separator(self, context_menu_namespace: str = "") -> None: ...

    def add_context_menu_check_item(
        self,
        context_menu_entry_function: Callable[..., Any],
        display_name: str = "",
        checked: bool = False,
        context_menu_namespace: str = "",
    ) -> None: ...

    def add_context_menu_radio_item(
        self,
        context_menu_entry_function: Callable[..., Any],
        display_name: str = "",
        group_id: int = 0,
        context_menu_namespace: str = "",
    ) -> None: ...

    def add_context_menu_submenu(
        self,
        display_name: str,
        sub_namespace: str,
        context_menu_namespace: str = "",
    ) -> None: ...

    def set_context_menu_item_enabled(
        self, item_index: int, enabled: bool, context_menu_namespace: str = "",
    ) -> None: ...

    def set_context_menu_item_checked(
        self, item_index: int, checked: bool, context_menu_namespace: str = "",
    ) -> None: ...

    def set_context_menu_item_visible(
        self, item_index: int, visible: bool, context_menu_namespace: str = "",
    ) -> None: ...

    def set_context_menu_item_accelerator(
        self,
        item_index: int,
        key_code: int,
        ctrl: bool = False,
        shift: bool = False,
        alt: bool = False,
        context_menu_namespace: str = "",
    ) -> None: ...

    def clear_context_menu_entries(self, context_menu_namespace: str = "") -> None: ...

    def on_before_context_menu(self, callback: Callable[..., None]) -> None: ...

    def create_browser(self, url: str, width: int, height: int, frameless: bool = False, icon_path: str = "") -> int: ...
    def close_browser(self) -> None: ...
    def get_browser_id(self) -> int: ...
    def shutdown(self) -> None: ...
    def is_running(self) -> bool: ...

    @classmethod
    def is_cef_initialized(cls) -> bool: ...
    def update_message_loop(self) -> None: ...
    def add_custom_scheme(self, scheme_identifier: str, scheme_content_root_folder: str) -> None: ...
    def add_mime_type_mapping(self, file_extension: str, mime_type: str) -> None: ...
    def set_cache_path(self, path: str) -> None: ...
    def set_custom_icon_path(self, path: str) -> None: ...
    def load_url(self, url: str) -> None: ...

    # Window control methods
    def set_frameless_window(self, frameless: bool) -> None: ...
    def set_osr_mode(self, osr: bool) -> None: ...
    def set_show_in_taskbar(self, show: bool) -> None: ...

    # Headless OSR mode — no OS window, raw BGRA buffer via callback
    def set_headless_mode(self, headless: bool) -> None:
        """Enable headless OSR mode (no window, buffer via callback).

        Implies set_osr_mode(True). Must be called before initialize().
        """
        ...
    def on_paint(self, callback: Callable[[memoryview, int, int], None]) -> None:
        """Register a callback for headless OSR paint events.

        callback receives (buffer, width, height). buffer is a memoryview
        of BGRA data, valid ONLY during the callback.
        """
        ...
    def set_headless_size(self, width: int, height: int) -> None:
        """Resize the headless viewport."""
        ...
    def get_paint_buffer(self) -> tuple[memoryview | None, int, int]:
        """Poll the last rendered frame. Returns (buffer_or_None, width, height)."""
        ...

    # Input forwarding (works with any browser mode)
    def send_mouse_move(self, x: int, y: int, mouse_leave: bool = False, modifiers: int = 0) -> None: ...
    def send_mouse_click(self, x: int, y: int, button: int = 0, mouse_up: bool = False,
                         click_count: int = 1, modifiers: int = 0) -> None: ...
    def send_mouse_wheel(self, x: int, y: int, delta_x: int = 0, delta_y: int = 0,
                         modifiers: int = 0) -> None: ...
    def send_key_event(self, windows_key_code: int, native_key_code: int = 0,
                       event_type: int = 0, modifiers: int = 0,
                       is_system_key: bool = False) -> None: ...
    def send_char_event(self, char_code: int, modifiers: int = 0) -> None: ...
    def send_focus_event(self, set_focus: bool) -> None: ...

    def set_parent_window(self, parent_hwnd: int) -> None: ...
    def minimize_window(self) -> None: ...
    def maximize_window(self) -> None: ...
    def restore_window(self) -> None: ...
    def close_window(self) -> None: ...
    def is_maximized(self) -> bool: ...
    def set_fullscreen(self, fullscreen: bool) -> None: ...
    def is_fullscreen(self) -> bool: ...
    def toggle_fullscreen(self) -> None: ...
    def drag_window(self, delta_x: int, delta_y: int) -> None: ...
    def start_window_drag(self) -> None:
        """Initiate a native OS window drag from the current cursor position.

        Call on mouse-down to let the OS handle the drag loop natively.
        Much smoother than delta-based dragging (zero IPC latency).
        """
        ...
    def center_window(self) -> None:
        """Center the window on its current monitor's work area.

        Call after initialize() to start centered. Works with multi-monitor setups.
        """
        ...
    def get_window_position(self) -> tuple[int, int]: ...
    def set_window_position(self, x: int, y: int) -> None: ...
    def get_window_size(self) -> tuple[int, int]: ...
    def set_window_size(self, width: int, height: int) -> None: ...
    def resize_window(self, new_width: int, new_height: int, anchor: int = 0) -> None: ...

    def set_state(self, namespace: str, key: str, value: Any) -> None: ...
    def generate_typescript_definitions(self, filename: str) -> None: ...

    # Native window handle (Windows: HWND as int, Linux: X11 window ID)
    def get_native_window_handle(self) -> int: ...

    # Window event callbacks
    def on_title_change(self, callback: Callable[[str], None]) -> None: ...
    def on_address_change(self, callback: Callable[[str], None]) -> None: ...
    def on_fullscreen_change(self, callback: Callable[[bool], None]) -> None: ...
